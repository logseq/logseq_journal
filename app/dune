   (:include native_static_link_flags.sexp)))
 (modes
  (native object)))

(rule
 (targets
  native_static_link_flags.sexp
  libgmp.a)
 (action
  (with-stdout-to
   native_static_link_flags.sexp
   (run ../tool/native_static_link_flags.sh libgmp.a))))


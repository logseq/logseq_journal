opam-version: "2.0"
name: "logseq_sync"
version: "0.1.0"
synopsis: "Managed Logseq sync runtime"
maintainer: "application authors"
authors: ["application authors"]
license: "MIT"
homepage: "https://github.com/RCmerci/logseq_journal"
bug-reports: "https://github.com/RCmerci/logseq_journal/issues"
depends: [
  "ocaml" {= "5.1.1"}
  "dune" {= "3.23.1"}
  "alcotest" {with-test & = "1.7.0"}
  "logseq_db_types" {= "0.1.0"}
  "logseq_db_storage" {= "0.1.0"}
  "bigstringaf" {= "0.10.0"}
  "ca-certs-nss" {= "3.126"}
  "cstruct" {= "6.2.0"}
  "datascript_ocaml" {= "dev"}
  "datascript-ocaml-native" {= "dev"}
  "digestif" {= "1.3.1"}
  "domain-name" {= "0.5.0"}
  "eio" {= "1.2"}
  "faraday" {= "0.8.2"}
  "httpun" {= "0.2.0"}
  "httpun-eio" {= "0.2.0"}
  "httpun-ws" {= "0.2.0"}
  "melange-transit-native" {= "0.1.2"}
  "mirage-crypto-rng" {= "2.2.0"}
  "sqlite3" {= "5.4.0"}
  "tls" {= "2.1.2"}
  "tls-eio" {= "2.1.2"}
  "uri" {= "4.4.0"}
  "uutf" {= "1.0.4"}
  "x509" {= "1.1.1"}
  "yojson" {= "3.0.0"}
]
depexts: ["zlib"]
pin-depends: [
  ["datascript_ocaml.dev" "git+https://github.com/logseq/datascript-ocaml.git#5895af25101de15f56d7c5df383c150ca07cef90"]
  ["datascript-ocaml-native.dev" "git+https://github.com/logseq/datascript-ocaml.git#5895af25101de15f56d7c5df383c150ca07cef90"]
  ["melange-transit-native.0.1.2" "git+https://github.com/RCmerci/melange-transit.git#35f8afe7d6506863c7253e67a20befb3dde5c18f"]
]
build: [["dune" "build" "-p" name "-j" jobs]]

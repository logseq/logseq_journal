opam-version: "2.0"
name: "logseq_overlay_db"
version: "0.1.0"
synopsis: "UUID-addressed logical overlay for Logseq graph storage"
maintainer: "application authors"
authors: "application authors"
license: "MIT"
homepage: "https://github.com/logseq/logseq_journal"
bug-reports: "https://github.com/logseq/logseq_journal/issues"
build: ["dune" "build" "-p" name "-j" jobs]
pin-depends: [
  [
  "datascript-ocaml-native.dev"
  "git+https://github.com/logseq/datascript-ocaml.git#0561660e4894faee250d551ab2a32a6b5c25a5fb"
]
  [
  "datascript_ocaml.dev"
  "git+https://github.com/logseq/datascript-ocaml.git#0561660e4894faee250d551ab2a32a6b5c25a5fb"
]
  [
  "melange-edn-core.0.5.0"
  "git+https://github.com/logseq/melange-edn.git#main"
]
  [
  "melange-edn-native.0.5.0"
  "git+https://github.com/logseq/melange-edn.git#main"
]
  [
  "melange-transit-core.0.1.2"
  "git+https://github.com/logseq/melange-transit.git#main"
]
  [
  "melange-transit-native.0.1.2"
  "git+https://github.com/logseq/melange-transit.git#main"
]
  [
  "persistent_sorted_set_ocaml.dev"
  "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#main"
]
  ["rrbvec.dev" "git+https://github.com/logseq/rrbvec.git#main"]
]
depends: [
  "alcotest" {= "1.7.0" & with-test}
  "astring" {= "0.8.5"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "bigstringaf" {= "0.10.0"}
  "cmdliner" {= "2.1.1"}
  "compiler-cloning" {= "disabled"}
  "conf-pkg-config" {= "5"}
  "conf-sqlite3" {= "1"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "datascript-ocaml-native" {= "dev"}
  "datascript_ocaml" {= "dev"}
  "digestif" {= "1.3.1"}
  "domain-local-await" {= "1.0.1"}
  "dune" {= "3.23.1"}
  "dune-build-info" {= "3.23.1"}
  "dune-compiledb" {= "0.6.0"}
  "dune-configurator" {= "3.23.1"}
  "eio" {= "1.2"}
  "eio_main" {= "1.2"}
  "eio_posix" {= "1.2"}
  "eqaf" {= "0.10"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "gen" {= "1.1"}
  "hex" {= "1.5.0"}
  "hmap" {= "0.8.1"}
  "iomux" {= "0.4"}
  "js_of_ocaml" {= "6.4.1"}
  "js_of_ocaml-compiler" {= "6.4.1"}
  "jsonm" {= "1.0.2"}
  "logseq_db_storage" {= "0.1.0"}
  "logseq_db_types" {= "0.1.0"}
  "lwt-dllist" {= "1.1.0"}
  "melange" {= "7.0.1-55"}
  "melange-edn-core" {= "0.5.0"}
  "melange-edn-native" {= "0.5.0"}
  "melange-transit-core" {= "0.1.2"}
  "melange-transit-native" {= "0.1.2"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "mtime" {= "2.1.0"}
  "num" {= "1.6"}
  "ocaml" {= "5.5.0"}
  "ocaml-base-compiler" {= "5.5.0"}
  "ocaml-compiler" {= "5.5.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "optint" {= "0.3.0"}
  "parsexp" {= "v0.17.0"}
  "persistent_sorted_set_ocaml" {= "dev"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.2.0"}
  "ppx_deriving_yojson" {= "3.10.0"}
  "ppxlib" {= "0.38.0"}
  "psq" {= "0.2.1"}
  "ptime" {= "1.2.0"}
  "re" {= "1.14.0" & with-test}
  "rrbvec" {= "dev"}
  "sedlex" {= "3.7"}
  "seq" {= "base"}
  "sexplib" {= "v0.17.0"}
  "sexplib0" {= "v0.17.0"}
  "sqlite3" {= "5.4.0"}
  "stdlib-shims" {= "0.3.0"}
  "thread-table" {= "1.0.0"}
  "topkg" {= "1.1.1"}
  "uucp" {= "17.0.0"}
  "uunf" {= "17.0.0"}
  "uutf" {= "1.0.4"}
  "yojson" {= "3.0.0"}
]

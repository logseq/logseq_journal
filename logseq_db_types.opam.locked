opam-version: "2.0"
name: "logseq_db_types"
version: "0.1.0"
synopsis: "Shared Logseq graph and sync boundary values"
maintainer: "application authors"
authors: "application authors"
license: "MIT"
homepage: "https://github.com/logseq/logseq_journal"
bug-reports: "https://github.com/logseq/logseq_journal/issues"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "compiler-cloning" {= "disabled"}
  "cppo" {= "1.8.0"}
  "dune" {= "3.23.1"}
  "ocaml" {= "5.5.0"}
  "ocaml-base-compiler" {= "5.5.0"}
  "ocaml-compiler" {= "5.5.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.2.0"}
  "ppx_deriving_yojson" {= "3.10.0"}
  "ppxlib" {= "0.38.0"}
  "sexplib0" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "yojson" {= "3.0.0"}
]
build: ["dune" "build" "-p" name "-j" jobs]

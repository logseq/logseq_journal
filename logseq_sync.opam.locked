  "logseq_db_storage" {= "0.1.0"}
  "logseq_db_types" {= "0.1.0"}
  "lwt-dllist" {= "1.1.0"}
  "macaddr" {= "5.6.2"}
  "melange" {= "5.1.0-51"}
  "melange-edn-core" {= "0.5.0"}
  "melange-edn-native" {= "0.5.0"}
  "melange-transit-core" {= "0.1.1"}
  "melange-transit-native" {= "0.1.1"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}

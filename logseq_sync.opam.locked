  "duration" {= "0.3.1"}
  "eio" {= "1.2"}
  "eqaf" {= "0.10"}
  "ezjsonm" {= "1.3.0"}
  "faraday" {= "0.8.2"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "gen" {= "1.1"}
  "gluten" {= "0.5.2"}
  "gluten-eio" {= "0.5.2"}
  "gmap" {= "0.3.0"}
  "hex" {= "1.5.0"}

  "menhirSdk" {= "20260209"}
  "mirage-crypto" {= "2.2.0"}
  "mirage-crypto-ec" {= "2.2.0"}
  "mirage-crypto-pk" {= "2.2.0"}
  "mirage-crypto-rng" {= "2.2.0"}
  "mirage-ptime" {= "5.2.0"}
  "mtime" {= "2.1.0"}
  "num" {= "1.6"}

build: ["dune" "build" "-p" name "-j" jobs]
depexts: "zlib"
pin-depends: [
  [
    "datascript-ocaml-native.dev"
    "git+https://github.com/logseq/datascript-ocaml.git#5895af25101de15f56d7c5df383c150ca07cef90"
  ]
  [
    "datascript_ocaml.dev"
    "git+https://github.com/logseq/datascript-ocaml.git#5895af25101de15f56d7c5df383c150ca07cef90"
  ]
  [
    "melange-edn-core.0.5.0"
    "git+https://github.com/RCmerci/melange-edn.git#3cb79f278e972388a0a2b2ea1caec7a008a0b956"
  ]
  [
    "melange-edn-native.0.5.0"
    "git+https://github.com/RCmerci/melange-edn.git#3cb79f278e972388a0a2b2ea1caec7a008a0b956"
  ]
  [
    "melange-transit-core.0.1.1"
    "git+https://github.com/RCmerci/melange-transit.git#a64270a1ed5c8ad3ff7e05dbb60e83ad0465ae93"
  ]
  [
    "melange-transit-native.0.1.1"
    "git+https://github.com/RCmerci/melange-transit.git#a64270a1ed5c8ad3ff7e05dbb60e83ad0465ae93"
  ]
  [
    "persistent_sorted_set_ocaml.dev"
    "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#4016dae1cdf4304207d8277ff9957656cdd8b177"
  ]
]

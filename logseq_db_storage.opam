opam-version: "2.0"
name: "logseq_db_storage"
version: "0.1.0"
synopsis: "Logseq DataScript and SQLite storage"
maintainer: "application authors"
authors: ["application authors"]
license: "MIT"
homepage: "https://github.com/logseq/logseq_journal"
bug-reports: "https://github.com/logseq/logseq_journal/issues"
depends: [
  "ocaml" {>= "5.5"}
  "dune" {= "3.23.1"}
  "logseq_db_types" {= "0.1.0"}
  "datascript_ocaml" {= "dev"}
  "datascript-ocaml-native" {= "dev"}
  "melange-transit-native" {= "0.1.2"}
  "persistent_sorted_set_ocaml" {= "dev"}
  "sqlite3" {= "5.4.0"}
  "yojson" {= "3.0.0"}
]
pin-depends: [
  ["datascript_ocaml.dev" "git+https://github.com/logseq/datascript-ocaml.git#b346cdd36e9d01af381da022723d3307fd26760d"]
  ["datascript-ocaml-native.dev" "git+https://github.com/logseq/datascript-ocaml.git#b346cdd36e9d01af381da022723d3307fd26760d"]
  ["melange-edn-core.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-edn-native.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-transit-core.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["melange-transit-native.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#main"]
]
build: [["dune" "build" "-p" name "-j" jobs]]

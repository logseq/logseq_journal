    "createJournalPage": {"target":"journalDayAndPageUuid","requiredPreconditions":["page"]},
    "setTaskStatus": {"target":"blockUuid","requiredPreconditions":["block"]},
    "clearTaskStatus": {"target":"blockUuid","requiredPreconditions":["block"]}

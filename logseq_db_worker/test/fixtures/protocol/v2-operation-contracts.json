    "graphInfo": {"interest":"graphInfo","revision":"generation"},
    "inspectAdmission": {"interest":"outboxAdmission","revision":"none"},
    "listJournals": {"interest":"journalIndex","revision":"pageRevision"},
    "getPage": {"interest":"pageUuid","revision":"pageRevision"},
    "getBlock": {"interest":"blockUuid","revision":"blockRevision"},
    "getChildren": {"interest":"childrenScope","revision":"structureRevision"},
    "getPageTree": {"interest":"pageTreeDepth","revision":"blockRevision"}

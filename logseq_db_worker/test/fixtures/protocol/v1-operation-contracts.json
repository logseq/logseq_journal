{
  "apiVersion": 1,
  "global": {
    "allSelectorsResolveBeforePlanning": true,
    "numericEntityIdsForbidden": true,
    "emptyMutationSelection": "invalidRequest",
    "oversizedInput": "invalidRequest",
    "staleBasis": "conflict",
    "persistenceFailure": "fatalSession"
  },
  "operations": {
    "saveBlock":{"selectors":["blockUuid"],"limits":["titleBytes"],"preconditions":["existingBlock","notBuiltIn","expectedBasis"],"noOp":"identicalDerivedState","errors":["notFound","builtInProtected","unsupportedSemantics","conflict"]},
    "insertBlocks":{"selectors":["positionBlockUuid"],"limits":["rootCount","treeNodes","treeDepth","titleBytes"],"preconditions":["nonEmptyRoots","uniqueCallerUuids","validPosition","expectedBasis"],"noOp":"alreadyAppliedOnlyWhenEntireTreeMatches","errors":["notFound","duplicateSelector","invalidTree","invalidPosition","unsupportedSemantics","conflict"]},
    "moveBlocks":{"selectors":["rootUuids","positionBlockUuid"],"limits":["rootCount"],"preconditions":["nonEmptyRoots","uniqueRoots","continuousCanonicalRoots","noCycle","expectedBasis"],"noOp":"never","errors":["notFound","duplicateSelector","invalidTree","invalidPosition","builtInProtected","conflict"]},
    "moveUpDown":{"selectors":["rootUuids"],"limits":["rootCount"],"preconditions":["nonEmptyRoots","uniqueRoots","expectedBasis"],"noOp":"topOrBottomBoundary","errors":["notFound","duplicateSelector","invalidTree","builtInProtected","conflict"]},
    "indentOutdent":{"selectors":["rootUuids"],"limits":["rootCount"],"preconditions":["nonEmptyRoots","uniqueRoots","continuousRoots","validDirectionTarget","expectedBasis"],"noOp":"never","errors":["notFound","duplicateSelector","invalidTree","invalidPosition","builtInProtected","conflict"]},
    "deleteBlocks":{"selectors":["rootUuids"],"limits":["rootCount"],"preconditions":["nonEmptyRoots","uniqueRoots","notBuiltIn","expectedBasis"],"noOp":"emptySelectionIsInvalid","errors":["notFound","duplicateSelector","builtInProtected","unsupportedSemantics","conflict"]},
    "createPage":{"selectors":[],"limits":["titleBytes"],"preconditions":["validKind","callerUuidForNonJournal","deterministicJournalUuid","noExistingOrRecycledCollision","expectedBasis"],"noOp":"identicalExistingIdentityMayBeAlreadyApplied","errors":["invalidRequest","conflict","unsupportedSemantics"]},
    "renamePage":{"selectors":["pageUuid"],"limits":["titleBytes"],"preconditions":["existingPage","notBuiltInOrHidden","unambiguousTitle","expectedBasis"],"noOp":"identicalDerivedState","errors":["notFound","ambiguousSelector","builtInProtected","unsupportedSemantics","conflict"]},
    "deletePage":{"selectors":["pageUuid"],"limits":[],"preconditions":["existingPage","eligiblePageKind","expectedBasis"],"noOp":"never","errors":["notFound","builtInProtected","unsupportedSemantics","conflict"]},
    "restoreRecycledPage":{"selectors":["pageUuid"],"limits":[],"preconditions":["recycledPageRoot","validRecordedTarget","expectedBasis"],"noOp":"never","errors":["notFound","invalidPosition","unsupportedSemantics","conflict"]},
    "permanentlyDeleteRecycledPage":{"selectors":["pageUuid"],"limits":[],"preconditions":["recycledPageRoot","expectedBasis"],"noOp":"never","errors":["notFound","builtInProtected","unsupportedSemantics","conflict"]},
    "upsertProperty":{"selectors":["propertyIdentOrUuid"],"limits":["titleBytes"],"preconditions":["qualifiedIdent","supportedUserType","validCardinality","existingValuesCompatible","expectedBasis"],"noOp":"identicalSchema","errors":["notFound","ambiguousSelector","invalidRequest","builtInProtected","unsupportedSemantics","conflict"]},
    "setProperty":{"selectors":["blockUuid","propertyIdentOrUuid"],"limits":["propertyValues"],"preconditions":["typedValue","cardinality","noSelfReference","expectedBasis"],"noOp":"typedEquality","errors":["notFound","ambiguousSelector","invalidRequest","builtInProtected","conflict"]},
    "removeProperty":{"selectors":["blockUuid","propertyIdentOrUuid"],"limits":[],"preconditions":["expectedBasis"],"noOp":"propertyAbsent","errors":["notFound","ambiguousSelector","builtInProtected","conflict"]},
    "batchSetProperty":{"selectors":["blockUuids","propertyIdentOrUuid"],"limits":["rootCount","propertyValues"],"preconditions":["nonEmptyUniqueBlocks","explicitAppendOrReplace","allValuesTyped","expectedBasis"],"noOp":"allTargetsAlreadyEqual","errors":["notFound","duplicateSelector","ambiguousSelector","invalidRequest","builtInProtected","conflict"]},
    "batchRemoveProperty":{"selectors":["blockUuids","propertyIdentOrUuid"],"limits":["rootCount"],"preconditions":["nonEmptyUniqueBlocks","expectedBasis"],"noOp":"allTargetsAlreadyAbsent","errors":["notFound","duplicateSelector","ambiguousSelector","builtInProtected","conflict"]},
    "manageClosedValues":{"selectors":["propertyIdentOrUuid","valueUuid"],"limits":["titleBytes"],"preconditions":["closedValueEligibleType","typedValue","expectedBasis"],"noOp":"identicalAssociationOrValue","errors":["notFound","ambiguousSelector","invalidRequest","builtInProtected","conflict"]},
    "manageClassProperty":{"selectors":["classUuid","propertyIdentOrUuid"],"limits":[],"preconditions":["classEntity","typedDefaultWhenPresent","expectedBasis"],"noOp":"relationAlreadyInFinalState","errors":["notFound","ambiguousSelector","invalidRequest","builtInProtected","conflict"]}
  }
}
